<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BenchBase">
		<defName>UFR_FerrocreteMixer</defName>
		<label>ferrocrete mixer</label>
		<description>An industrial mixing table that grinds stone chunks and blends them with steel fibre into ferrocrete mix. The mix must then be fired in a ferrocrete kiln.</description>
		<thingClass>Building_WorkTable</thingClass>
		<graphicData>
			<texPath>UFRC/Things/FerrocreteTable/FerrocreteTable</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3.5,1.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>2500</WorkToBuild>
			<MaxHitPoints>180</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Cleanliness>-5</Cleanliness>
		</statBases>
		<size>(3,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<recipes>
			<li>UFR_Make_FerrocreteMix</li>
		</recipes>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>250</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
					<li MayRequire="VanillaExpanded.VFEProduction">VFE_FabricationCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<workTableRoomRole>Workshop</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
		</building>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>UFR_FerrocreteProduction</li>
		</researchPrerequisites>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>UFR_FerrocreteKiln</defName>
		<label>ferrocrete kiln</label>
		<description>An electric kiln that fires ferrocrete mix into ferrocrete bricks. Load it with mix and let it fire; a pawn collects the bricks once the batch is done. Losing power pauses firing.</description>
		<tickerType>Rare</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<size>(3,3)</size>
		<rotatable>false</rotatable>
		<graphicData>
			<texPath>UFRC/Things/FerrocreteKiln</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
		<fillPercent>0.6</fillPercent>
		<blockWind>true</blockWind>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>Production</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Mass>50</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>120</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>UFR_KilnIdle</notWorkingKey>
				<showProgressBar>true</showProgressBar>
				<processes>
					<li>UFR_FireFerrocrete</li>
				</processes>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>400</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>4</heatPerSecond>
			</li>
		</comps>
		<researchPrerequisites>
			<li>UFR_FerrocreteProduction</li>
		</researchPrerequisites>
	</ThingDef>

</Defs>