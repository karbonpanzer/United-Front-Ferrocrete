<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef Name="UFR_FerrocretePlantBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>Building</thingClass>
		<size>(2,2)</size>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.6</fillPercent>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>VCHE_PipeNetworks</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
		<researchPrerequisites>
			<li>UFR_FerrocreteProduction</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="UFR_FerrocretePlantBase">
		<defName>UFR_FerrocreteGrinder</defName>
		<label>ferrocrete grinder</label>
		<description>An industrial grinder and mixer. It pulls stone blocks and steel from hoppers placed directly left and right of its bottom row, grinds the stone, shreds the steel into reinforcing fibre, mixes them into ferrocrete slurry, and pumps the slurry into a connected pipe network. Slurry needs vat space: if every vat is full, the current small batch is lost.</description>
		<tickerType>Rare</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>UFRC/Things/Building/FerrocreteProduction/FerrocreteGrinder</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2500</WorkToBuild>
			<Mass>60</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<building>
			<wantsHopperAdjacent>true</wantsHopperAdjacent>
		</building>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>UFR_SlurryNet</pipeNet>
			</li>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>UFR_GrinderIdle</notWorkingKey>
				<showProgressBar>true</showProgressBar>
				<processes>
					<li>UFR_GrindSlurry</li>
				</processes>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="UFR_FerrocretePlantBase">
		<defName>UFR_FerrocreteVat</defName>
		<label>ferrocrete slurry vat</label>
		<description>An agitated storage vat that keeps ferrocrete slurry from setting. Buffers slurry between grinders and kilns.</description>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>UFRC/Things/Building/FerrocreteProduction/FerrocretePipelineVat</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
			<Mass>30</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<costList>
			<Steel>100</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_ResourceStorage">
				<pipeNet>UFR_SlurryNet</pipeNet>
				<storageCapacity>500</storageCapacity>
				<barSize>(0.75, 0.20)</barSize>
				<margin>0.05</margin>
				<centerOffset>(0, 0, -0.35)</centerOffset>
				<destroyOptions>
					<li>
						<thing>Filth_RubbleRock</thing>
						<ratio>0.05</ratio>
						<maxRadius>3</maxRadius>
					</li>
				</destroyOptions>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="UFR_FerrocretePlantBase">
		<defName>UFR_FerrocreteKiln</defName>
		<label>ferrocrete kiln</label>
		<description>An electric kiln that draws slurry from a connected pipe network and slowly fires it in large batches, pushing a stack of ferrocrete bricks out beside itself every half day. Two kilns keep pace with one grinder.</description>
		<tickerType>Normal</tickerType>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>UFRC/Things/Building/FerrocreteProduction/FerrocreteKiln</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Mass>50</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>120</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_ResourceProcessor">
				<pipeNet>UFR_SlurryNet</pipeNet>
				<showBufferInfo>true</showBufferInfo>
				<notWorkingKey>UFR_KilnIdle</notWorkingKey>
				<results>
					<li>
						<countNeeded>100</countNeeded>
						<eachTicks>30000</eachTicks>
						<thing>UFR_FerrocreteBricks</thing>
						<thingCount>50</thingCount>
					</li>
				</results>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>400</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>4</heatPerSecond>
			</li>
		</comps>
	</ThingDef>

</Defs>