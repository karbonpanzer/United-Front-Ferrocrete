<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraderKindDef[defName="Base_UFR_Standard"]/stockGenerators</xpath>
		<value>
			<li Class="StockGenerator_SingleDef">
				<thingDef>UFR_FerrocreteBricks</thingDef>
				<countRange>300~800</countRange>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraderKindDef[defName="Caravan_UFR_BulkGoods"]/stockGenerators</xpath>
		<value>
			<li Class="StockGenerator_SingleDef">
				<thingDef>UFR_FerrocreteBricks</thingDef>
				<countRange>150~400</countRange>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ScenarioDef[defName="UFR_Colonization"]/scenario/parts</xpath>
		<value>
			<li Class="ScenPart_StartingResearch">
				<def>StartingResearch</def>
				<project>UFR_FerrocreteProduction</project>
			</li>
			<li Class="ScenPart_StartingThing_Defined">
				<def>StartingThing_Defined</def>
				<thingDef>UFR_FerrocreteBricks</thingDef>
				<count>200</count>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ScenarioDef[defName="UFR_Occupation"]/scenario/parts</xpath>
		<value>
			<li Class="ScenPart_StartingResearch">
				<def>StartingResearch</def>
				<project>UFR_FerrocreteProduction</project>
			</li>
		</value>
	</Operation>

</Patch>
